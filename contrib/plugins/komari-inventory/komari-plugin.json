{
  "$schema": "https://raw.githubusercontent.com/komari-monitor/plugin-sdk/main/schema/komari-plugin.schema.json",
  "name": {
    "zh-CN": "资产台账",
    "en": "Inventory"
  },
  "short": "komari-inventory",
  "description": {
    "zh-CN": "为每个节点手工维护服务、域名和端口，并通过一次性命令安全导入只读扫描结果。",
    "en": "Maintain node inventory and safely import read-only scans with single-use commands."
  },
  "author": "a1",
  "version": "0.3.1",
  "entry": "script.js",
  "komari": ">1.4.3",
  "permissions": {
    "node": true,
    "allowRoutes": true,
    "maxHTTPBodyBytes": 524288,
    "timeout": 15
  },
  "pages": [
    {
      "file": "pages/admin.html",
      "title": {
        "zh-CN": "资产台账",
        "en": "Inventory"
      },
      "visibility": "admin"
    }
  ]
}
